{
  "schema_version": 1,
  "api_version": 9,
  "id": "philips-strip3",
  "kind": "light",
  "entry_class": "frameluma.devices.philips.strip3.Adapter",
  "display_name": {
    "zh": "米家追光氛围灯带",
